{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntentRouterLLMOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["primary_route", "confidence"],
  "properties": {
    "primary_route": {
      "type": "string",
      "enum": [
        "Physical",
        "SessionOps",
        "Concierge",
        "Emergency",
        "Security",
        "Store",
        "Counseling",
        "Unknown"
      ]
    },
    "sub_route": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning": {
      "type": "string"
    }
  }
}
