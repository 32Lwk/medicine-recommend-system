        <mxCell id="s_sec3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;fontStyle=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;" value="3. カウンセリングフロー（カウンセリングモード有効時: 入力処理 → 話題転換/new_category 判定 → Emergency緊急案内 / Physical+不眠・眠気で推奨へ / その他でカウンセリング応答）" vertex="1">
          <mxGeometry height="580" width="3560" x="220" y="1640" as="geometry" />
