{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Medicine Recommend: app.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "env": {
        "OPEN_BROWSER": "1",
        "APP_ENV": "development"
      },
      "justMyCode": true
    }
  ]
}
