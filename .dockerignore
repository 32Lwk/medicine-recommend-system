# Git / IDE / ローカル専用
# .git は Docker ビルド時の write_build_meta（コミット日・ハッシュ）解決に必要（最終イメージには含めない）
.github
.cursor
.vscode
.idea

# Python 仮想環境・キャッシュ
.venv
.venv*/
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
*.egg-info
dist
build

# 機密・ローカル設定
.env
*.env
.tmp_*

# ログ（本番は実行時に log/ を自動作成）
log

# テスト・開発用
tests
test_snapshots
test_report.html
# scripts は開発用が大半のため除外。Docker ビルドメタ / local RAG 生成のみ許可
scripts/*
!scripts/write_build_meta.py
!scripts/write_changelog_digest.py
!scripts/build_medicine_kb_documents.py

# ドキュメント（Concierge / public / ops のみ Dockerfile で COPY）
docs/**
!docs/public/
!docs/public/**
!docs/concierge/
!docs/concierge/**
!docs/ops/
!docs/ops/**

# デプロイ設定（コンテナ内不要）
render.yaml
README.md
# CHANGELOG.md はビルド時に digest 化するためコンテキストには含める（ランタイム COPY は digest のみ）
!CHANGELOG.md
Makefile
git-sync.ps1

# iOS 等（.gitignore と同様）
ios
