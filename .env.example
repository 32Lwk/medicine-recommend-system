# OpenAI（本番/ステージング分離推奨）
OPENAI_API_KEY=
OPENAI_API_KEY_PRODUCTION=
OPENAI_API_KEY_STAGING=

# LLM プロファイル: legacy | gpt5（未設定時コード既定は gpt5）
# LLM_MODEL_PROFILE=gpt5
# ロール別上書き（legacy 切り戻し時のみ。gpt5 時は get_model がプロファイルを優先）
# OPENAI_MODEL_TRIAGE=gpt-4o-mini
# OPENAI_MODEL_NLU=gpt-4o-mini
# OPENAI_MODEL_EXPLAIN=gpt-4o
# OPENAI_MODEL_COUNSEL=gpt-4o-mini
# triage/explain はロール別 Responses（全体スイッチは false 可）
OPENAI_USE_RESPONSES_API=false

# 機能フラグ（agent ON = 全セッションがエージェント経路。OFF = 従来経路のみ）
LLM_AGENT_ENABLED=true
LLM_GPT_RECOMMEND_FALLBACK=false
LLM_CANARY_PERCENT=0

# Chat Pipeline v2（Web / LINE 共通）
# 未設定 = ON（全セッション v2 + IntentRouter + dispatch + LLM 一括 ON）。
# ロールバック: CHAT_PIPELINE_V2=false または CHAT_PIPELINE_V2_DENYLIST=<sid>
# PRIMARY / TRIM も未設定 = ON。CHAT_PIPELINE_V2_INTENT_ROUTER_PRIMARY=false で PRIMARY OFF。

# ルーティング（ConfidenceGate / 履歴）
TRIAGE_CONFIDENCE_THRESHOLD=0.75
TRIAGE_HISTORY_MESSAGES=5

# トリアージ LRU キャッシュ
TRIAGE_CACHE_MAX_ENTRIES=256
TRIAGE_CACHE_TTL_SEC=600

# 管理画面メッセージ抜粋
ADMIN_LIST_SNIPPET_MAX_CHARS=120
ADMIN_DETAIL_USER_MESSAGE_MAX_CHARS=800

# 予算（OpenAI API 費用のみ・円）
OPENAI_MONTHLY_BUDGET_JPY=50000
OPENAI_SESSION_COST_ALERT_JPY=15

# Neon / PostgreSQL
# ローカル開発: Docker Postgres（docker compose up -d 後）
DATABASE_URL=postgresql://medicine:medicine@localhost:5432/medicine_recommend
# 上記 localhost は起動時に sslmode=disable が自動付与されます（明示する場合は ?sslmode=disable）
# app.py 起動時に docker compose up -d と DB 接続待ちを行う（0 で無効）
# LOCAL_DOCKER_DB_AUTO=1
# LOCAL_DOCKER_DB_WAIT_SEC=60
# Cloud Run dev 用 Neon（ローカル .env には置かない — Secret / gcloud env で管理）
# DATABASE_URL_DEV_NEON=postgresql://...@ep-xxx-pooler.../neondb?sslmode=require
# 旧: 単一 Neon をローカルと dev で共有していた設定（非推奨）
# または個別指定（DATABASE_URL 未設定時のみ使用）
# POSTGRES_HOST=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# DATABASE_SSLMODE=require

# Admin（管理画面 Cookie 署名用 — SECRET_KEY は本番必須推奨）
ADMIN_PASSWORD=
SECRET_KEY=
APP_ENV=development

# 開発日次 Markdown ログ (log/log/yyyy-mm-dd-n.md)。詳細 DEBUG は app.log 参照
# DEV_MARKDOWN_LOG_LEVEL=INFO
# DEV_MARKDOWN_LOG_INCLUDE_SCORING=1

# 開発専用: チャットに以下の文字列だけを送るとエラーUIプレビュー（本番では無効）
# 一覧: docs/DEV_ERROR_UI_PREVIEW.md / CHANGELOG.md「開発用エラー UI プレビュー」
# 固定の難読語を推奨（症状文と被らない）。未設定時は mrcdev00000000000001 等の既定値。
# DEV_ERROR_TRIGGER_CLIENT=mrcdev00000000000001
# DEV_ERROR_TRIGGER_WARNING=mrcdev00000000000002
# DEV_ERROR_TRIGGER_HTTP500=mrcdev00000000000003
# DEV_ERROR_TRIGGER_HTML_SYSTEM=mrcdev00000000000004
# DEV_ERROR_TRIGGER_HTML_CAUTION=mrcdev00000000000005
# DEV_ERROR_TRIGGER_HTML_NOTICE=mrcdev00000000000006
# DEV_ERROR_TRIGGER_HTML_CRITICAL=mrcdev00000000000007

# LINE Messaging API（Webhook + Reply/Push。既定は無効）
# LINE Developers のチャネル基本設定 / Messaging API 設定から取得
# LINE_CHANNEL_SECRET — Webhook 署名検証に必須（LINE_WEBHOOK_ENABLED=true 時）
LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN — Reply API / Push API に必須（返信・プッシュ送信時）
LINE_CHANNEL_ACCESS_TOKEN=
# LINE_WEBHOOK_ENABLED — true のとき POST /line/webhook を有効化（本番は false 推奨）
LINE_WEBHOOK_ENABLED=false
# LINE_PUSH_TO_USER_ID — scripts/line_push_preview.py 用（自分の userId。Webhook では未使用）
LINE_PUSH_TO_USER_ID=
# LINE_LOADING_SECONDS — 処理中の「…」表示秒数（5〜60、既定 60）。Messaging API loading/start
# LINE_LOADING_SECONDS=60

# 開発専用: LINE に以下の文字列だけを送ると Flex/テキストのサンプル Push（本番では無効）
# 一覧: docs/DEV_LINE_FLEX_PREVIEW.md
# DEV_LINE_TRIGGER_FLEX_SUCCESS=mrcdevline00000001
# DEV_LINE_TRIGGER_FLEX_ESCALATION=mrcdevline00000002
# DEV_LINE_TRIGGER_FLEX_CRISIS=mrcdevline00000003
# DEV_LINE_TRIGGER_FLEX_QUESTIONS=mrcdevline00000004
# DEV_LINE_TRIGGER_FLEX_SAFE_ERROR=mrcdevline00000005

# Gunicorn（Cloud Run / Docker。LINE 推奨の長時間処理向けに 300 推奨）
# GUNICORN_TIMEOUT=300
# GUNICORN_GRACEFUL_TIMEOUT=60

# 緊急事案メール（手動キュー登録時・管理 alert_email 宛）
EMERGENCY_EMAIL_ENABLED=true

# SMTP（セッションコストアラート・緊急通知・遅延通知）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Cloudflare R2 — OTC 商品画像 CDN（GCP / AWS 共通可。未設定時はプレースホルダーのみ）
# ---------------------------------------------------------------------------
# MEDICINE_IMAGE_CDN_BASE=https://images.yutok.dev/otc/
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=          # R2 管理用（Git に載せない）
# R2_ACCESS_KEY_ID=              # S3 互換アップロード用
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=medicine-recommend-otc-images
# R2_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# ---------------------------------------------------------------------------
# AWS 機能フラグ — aws.medicine.yutok.dev（ECS）のみ設定。GCP Cloud Run では未設定のまま。
# 詳細: docs/ops/AWS_FEATURES_ROLLOUT.md
# ---------------------------------------------------------------------------
# TRANSLATION_PROVIDER=deepl       # AWS: translate
# CONCIERGE_RAG_PROVIDER=local     # AWS: bedrock_kb
# MEDICINE_RAG_PROVIDER=local      # AWS: bedrock_kb（AskAgent / Explanation RAG）
# TTS_PROVIDER=webspeech           # AWS: polly
# COMPREHEND_MEDICAL_ENABLED=false
# REDIS_URL=
# PERSONALIZE_CAMPAIGN_ARN=
# PERSONALIZE_TRACKING_ID=
# STATIC_CDN_BASE_URL=             # AWS CloudFront（static/）
# BEDROCK_KB_ID=2CNAGQ2V4P         # Concierge Managed KB（AWS ステージング）
# BEDROCK_MEDICINE_KB_ID=30BCEJCJHA  # 医薬品 Managed KB（AWS ステージング）
# BEDROCK_KB_SEARCH_MODE=managed   # managed | vector（旧 Customer-managed KB 用）
# BEDROCK_KB_MIN_SCORE=0.4          # retrieve 時に捨てる chunk の score 下限（Phase Q2-d）
# AWS_REGION=ap-northeast-1
# AWS_PROFILE=medicine-recommend-dev   # ローカル CLI 既定（scripts/lib/aws_common.sh と同じ）
