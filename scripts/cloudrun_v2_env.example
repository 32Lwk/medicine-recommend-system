# Cloud Run — Chat Pipeline v2 環境変数（2026-07 以降: 未設定 = v2 + PRIMARY + TRIM すべて ON）
#
# 参照:
#   docs/ops/CLOUD_RUN_LLM_ENV.md
#   docs/dev/CHAT_PIPELINE_V2.md
#
# ロールバック（コード revert 不要）:
#   CHAT_PIPELINE_V2=false
#   CHAT_PIPELINE_V2_DENYLIST=<sid>
#   CHAT_PIPELINE_V2_INTENT_ROUTER_PRIMARY=false
#   CHAT_PIPELINE_V2_LEGACY_FALLBACK_TRIM=false

APP_ENV=production

# 通常は以下を設定不要（未設定 = ON）。問題時のみ false を明示。
# CHAT_PIPELINE_V2=false
# CHAT_PIPELINE_V2_INTENT_ROUTER_PRIMARY=false
# CHAT_PIPELINE_V2_LEGACY_FALLBACK_TRIM=false
