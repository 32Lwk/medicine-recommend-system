# Cloud Run / ローカル — Chat Pipeline v2 環境変数例
# dev カナリア: ALLOWLIST で sid を限定すること

CHAT_PIPELINE_V2=true
CHAT_PIPELINE_V2_ALLOWLIST=line:YOUR_LINE_USER_ID
CHAT_PIPELINE_V2_INTENT_ROUTER=true
